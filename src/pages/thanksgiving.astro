---
// Thanksgiving picks (docs/thanksgiving-spec.md). Static page; the React app talks to Firestore
// and the sign-in service from the browser.
import Base from '../layouts/Base.astro';
import App from '../components/thanksgiving/App';
import '../styles/thanksgiving.css';
---

<Base title="Thanksgiving Picks" description="Family pick'em for the Thanksgiving NFL games." noindex>
  <h1>Thanksgiving Picks 🦃</h1>
  <p class="muted">
    Three games on Thursday, Nov 26. Make your picks for each game before it kicks off; everyone's picks are revealed
    at kickoff.
  </p>
  <App client:only="react" />
</Base>
