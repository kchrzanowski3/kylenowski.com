---
// Admin screen for the TEST copy of the Thanksgiving picks (docs/thanksgiving-spec.md, "Test
// contest"). Same admin sign-in as /thanksgiving/admin; every read and change is on the test
// contest's tgTest* collections.
import Base from '../../layouts/Base.astro';
import AdminApp from '../../components/thanksgiving/admin/AdminApp';
import '../../styles/thanksgiving.css';
---

<Base title="TEST · Thanksgiving Picks · Admin" description="Admin screen for the test run of the Thanksgiving picks." noindex>
  <p class="tg-test-banner" role="note" data-testid="tg-test-banner">
    <strong>TEST</strong> Admin for the practice run (Nov 23 and Nov 25 games). Changes here don't touch the real
    Thanksgiving game.
  </p>
  <h1>Thanksgiving Picks: admin (test)</h1>
  <p class="muted"><a href="/thanksgiving-test">Back to the test picks</a></p>
  <AdminApp client:only="react" contest="test" />
</Base>
